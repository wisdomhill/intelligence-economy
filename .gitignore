# Quarto build output
/_site/
/.quarto/
/_freeze/
*_files/
*.quarto_ipynb

# Local render artefacts
# these live one level deeper than the original patterns assumed
/reports/**/*.pdf
/reports/**/*.html
/reports/**/*.typ
/reports/**/*.tex

# Handoff bundle: a snapshot of this repository, which git already carries.
# Keeping it in the tree would commit a stale 2.7 MB duplicate of the source.
/intelligence-economy.zip

# Manuscripts awaiting conversion. The repository is public, so a manuscript
# is committed when its report is published, not before. Un-ignore each one as
# it is converted — see the checklist in FRONTMATTER.md.
/manuscripts/*
!/manuscripts/prologue-about-this-series.md
!/manuscripts/r01-the-agentic-inflection.md
!/manuscripts/r02-the-idea-bottleneck.md
!/manuscripts/r03-the-token-economics-of-coding-agents.md
